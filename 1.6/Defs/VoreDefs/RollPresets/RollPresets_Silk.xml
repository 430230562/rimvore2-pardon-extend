<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Silk gland: turns leftover prey nutrition into living silk -->
  <RimVore2.RollPresetDef ParentName="CreateThing">
    <defName>ConvertNutritionToSilk</defName>
    <actionsOnSuccess>
      <li Class="RimVore2.RollAction_CreateThingsFromDef">
        <name>PreyNutrition</name>
        <minValue>0</minValue>
        <requiredNutrition>0.1</requiredNutrition>
        <things>
          <li>RV2_Resource_Silk</li>
        </things>
      </li>
    </actionsOnSuccess>
  </RimVore2.RollPresetDef>
</Defs>